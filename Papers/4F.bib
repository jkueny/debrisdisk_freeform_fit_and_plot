Type: 10.3847/1538-4357/ab3403},
	keywords = {Astrophysics, Earth and Planetary Astrophysics; Astrophysics - Solar and Stellar, individual: HD 191089; techniques: image processing; Astrophysics -, protoplanetary disks; radiative transfer; stars: imaging; stars:},
	pages = {64},
